  "faq": [
    {
      "id": "faq-1",
      "order": 1,
      "question": {
        "en": "Can I order from a store that isn't on your list, like a small independent shop on Etsy or a brand's own website?",
        "fr": "Puis-je commander sur une boutique qui n'est pas dans votre liste, comme une petite boutique indépendante sur Etsy ou le site officiel d'une marque ?"
      },
      "answer": {
        "en": "Yes. Paste the link, for example https://www.example.com/products/handmade-leather-sandals-size-42-brown-limited-edition?variant=4419283, and we quote it.",
        "fr": "Oui. Collez le lien, par exemple https://www.example.com/products/handmade-leather-sandals-size-42-brown-limited-edition?variant=4419283, et nous vous faisons un devis."
      },
      "defaultOpen": true
    },
    {
      "id": "faq-9",
      "order": 2,
      "question": {
        "en": "Is the app free?",
        "fr": "L'application est-elle gratuite ?"
      },
      "answer": {
        "en": "Yes. GlobalBuy24 is free to download. You only pay for what you order, and your quote shows every cost before you pay.",
        "fr": "Oui. GlobalBuy24 est gratuite à télécharger. Vous ne payez que ce que vous commandez, et votre devis affiche chaque coût avant le paiement."
      },
      "defaultOpen": false
    },
    {
      "id": "faq-10",
      "order": 3,
      "question": {
        "en": "Can family abroad order for me?",
        "fr": "Un proche à l'étranger peut-il commander pour moi ?"
      },
      "answer": {
        "en": "Yes. Someone abroad can order in the app and pay with an MTN or Orange Mobile Money account in Cameroon, and you collect the order at your city's pickup point. Bank cards are coming soon. Need another way to pay? Email [support@globalbuy24.com](mailto:support@globalbuy24.com).",
        "fr": "Oui. Un proche à l'étranger peut commander dans l'app et payer avec un compte MTN ou Orange Mobile Money au Cameroun, et vous récupérez la commande au point de retrait de votre ville. Les cartes bancaires arrivent bientôt. Besoin d'un autre moyen de paiement ? Écrivez à [support@globalbuy24.com](mailto:support@globalbuy24.com)."
      },
      "defaultOpen": false
    },
    {
      "id": "faq-4",
      "order": 4,
      "question": {
        "en": "How do I collect my order?",
        "fr": "Comment récupérer ma commande ?"
      },
      "answer": {
        "en": "At the GlobalBuy24 pickup point in your city. You get a notification when your order arrives and choose when to collect. Bring an ID.",
        "fr": "Au point de retrait GlobalBuy24 de votre ville. Vous êtes notifié à l'arrivée de votre commande et choisissez quand passer. Apportez une pièce d'identité."
      },
      "defaultOpen": false
    },
    {
      "id": "faq-8",
      "order": 5,
      "question": {
        "en": "What if something goes wrong with my order?",
        "fr": "Et si un problème survient avec ma commande ?"
      },
      "answer": {
        "en": "Message us from your order page in the app. Every active order has live chat with our team, in French and English.",
        "fr": "Écrivez-nous depuis la page de votre commande dans l'app. Chaque commande en cours dispose d'un chat en direct avec notre équipe, en français et en anglais."
      },
      "defaultOpen": false
    },
    {
      "id": "faq-7",
      "order": 6,
      "question": {
        "en": "Is there anything you won't ship?",
        "fr": "Y a-t-il des articles interdits ?"
      },
      "answer": {
        "en": "Yes. GlobalBuy24 doesn't ship weapons, counterfeits, narcotics, hazardous materials, or items banned under Cameroonian import law.",
        "fr": "Oui. GlobalBuy24 n'expédie pas d'armes, de contrefaçons, de stupéfiants, de matières dangereuses ni d'articles interdits par la loi camerounaise."
      },
      "defaultOpen": false
    }
  ],
