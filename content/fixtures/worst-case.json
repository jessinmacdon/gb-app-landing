    "steps": [
      {
        "order": 1,
        "title": {
          "en": "Paste a link",
          "fr": "Collez un lien"
        },
        "body": {
          "en": "Find a product on any online store and copy its link. Paste it into GlobalBuy24.",
          "fr": "Trouvez un produit sur n'importe quelle boutique en ligne et copiez son lien. Collez-le dans GlobalBuy24."
        }
      },
      {
        "order": 2,
        "title": {
          "en": "Get an instant quote",
          "fr": "Recevez un devis instantané"
        },
        "body": {
          "en": "GlobalBuy24 calculates the full cost: the product price, international shipping, customs and its service fee.",
          "fr": "GlobalBuy24 calcule le coût total : prix du produit, livraison internationale, douane et frais de service."
        }
      },
      {
        "order": 3,
        "title": {
          "en": "Pay with Mobile Money",
          "fr": "Payez par Mobile Money"
        },
        "body": {
          "en": "Confirm the quote and pay instantly using MTN Mobile Money or Orange Money. GlobalBuy24 then purchases the item on your behalf.",
          "fr": "Confirmez le devis et payez instantanément avec MTN Mobile Money ou Orange Money. GlobalBuy24 achète ensuite l'article pour vous."
        }
      },
      {
        "order": 4,
        "title": {
          "en": "Collect locally",
          "fr": "Récupérez près de chez vous"
        },
        "body": {
          "en": "GlobalBuy24 handles shipping and customs. When your order arrives at your city's pickup point, you get a notification and choose when to collect.",
          "fr": "GlobalBuy24 gère la livraison et la douane. Quand votre commande arrive au point de retrait de votre ville, vous êtes notifié et choisissez quand la récupérer."
        }
      }
    ],
    "features": [
      {
        "order": 1,
        "title": {
          "en": "Official sellers and authorised resellers only",
          "fr": "Uniquement des vendeurs officiels et des revendeurs agréés"
        },
        "body": {
          "en": "GlobalBuy24 buys directly from official retailers and authorised sellers only.",
          "fr": "GlobalBuy24 achète uniquement auprès de distributeurs officiels et de vendeurs agréés."
        }
      },
      {
        "order": 2,
        "title": {
          "en": "Full tracking",
          "fr": "Suivi complet"
        },
        "body": {
          "en": "Every stage from purchase to customs to pickup notification is visible in the app.",
          "fr": "Chaque étape, de l'achat à la douane jusqu'à la notification de retrait, est visible dans l'app."
        }
      },
      {
        "order": 3,
        "title": {
          "en": "Bilingual support",
          "fr": "Support bilingue"
        },
        "body": {
          "en": "Customer service in French and English in the app, with live chat for every active order.",
          "fr": "Service client en français et en anglais dans l'app, avec un chat en direct pour chaque commande en cours."
        }
      }
    ],
